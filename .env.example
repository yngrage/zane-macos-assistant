# ZANE configuration - placeholders only. Never commit real keys (.env is git-ignored).
#
# Preferred for the API key on macOS: the Keychain, not this file:
#     bash scripts/run.sh key set
# Resolution order: real environment variable > this .env file > macOS Keychain.
ANTHROPIC_API_KEY=

# Model used for reasoning (any current Claude model id). Smaller = cheaper and faster.
ZANE_MODEL=claude-sonnet-5

# Where ZANE keeps its database (memory, tasks, audit log), logs and exports.
# Default on macOS: ~/Library/Application Support/ZANE
# ZANE_HOME=

# Folders ZANE may list/read and (with your approval) change. Separate with ':'.
# Default: ~/Downloads. Per-project access is better: /projects add NAME PATH inside ZANE.
# ZANE_APPROVED_DIRS=~/Downloads:~/Projects

# Answer unambiguous commands ("open Safari", "battery") locally, without calling the model.
# ZANE_FAST_PATH=1
# In-app reminder checks (fire only while ZANE is running). 0 disables the background thread.
# ZANE_REMINDERS=1
# ZANE_TIMEOUT=60
# ZANE_MAX_TOKENS=1500
# ZANE_LOG_LEVEL=INFO
